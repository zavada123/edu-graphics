{
	"name": "edu-graphics",
	"version": "0.1.0",
	"author": "zavada123",
	"description": "Тренажер графічного редактора для уроків інформатики: шари, пензель, заливка, фігури, текст і завдання з перевіркою. Заснований на miniPaint.",
	"scripts": {
		"server": "node scripts/svgedit.mjs && webpack serve --mode development --env development --open",
		"dev": "node scripts/svgedit.mjs && webpack --mode development",
		"build": "node scripts/svgedit.mjs && webpack --mode production",
		"test": "node --no-warnings --test test/*.test.mjs",
		"e2e": "node test/e2e.mjs",
		"lib": "npm run build && node --no-warnings scripts/lib.mjs"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zavada123/edu-graphics"
	},
	"homepage": "https://zavada123.github.io/edu-graphics/",
	"license": "MIT",
	"devDependencies": {
		"@babel/core": "^7.14.5",
		"@babel/plugin-transform-runtime": "^7.14.5",
		"@babel/preset-env": "^7.14.5",
		"babel-loader": "^8.2.2",
		"css-loader": "^5.2.6",
		"source-map-loader": "^3.0.0",
		"style-loader": "^2.0.0",
		"svgedit": "7.4.2",
		"webpack": "^5.106.2",
		"webpack-cli": "^7.0.2",
		"webpack-dev-server": "^5.2.3"
	},
	"dependencies": {
		"@babel/runtime": "^7.14.5",
		"alertifyjs": "^1.13.1",
		"blueimp-canvas-to-blob": "^3.28.0",
		"exif-js": "^2.3.0",
		"file-saver": "^2.0.5",
		"fuzzysort": "^1.1.4",
		"gif.js.optimized": "^1.0.1",
		"hermite-resize": "git+https://github.com/viliusle/Hermite-resize.git",
		"jquery": "^3.5.1",
		"pica": "^7.0.0",
		"semver-compare": "^1.0.0",
		"uuid": "^8.3.2",
		"webfontloader": "^1.6.28"
	},
	"contributors": [
		"Vilius L. (miniPaint, https://github.com/viliusle/miniPaint)"
	],
	"files": [
		"lib/",
		"LICENSE",
		"MIT-LICENSE.txt",
		"README.md"
	],
	"exports": {
		"./lessons.json": "./lib/lessons.json",
		"./lib/*": "./lib/*",
		"./package.json": "./package.json"
	}
}
